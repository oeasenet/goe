<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Title }}</title>
    <style>
        /*
         * Goe Framework - Default Error Page
         * Copyright (c) 2024 OeaseNet
         * Licensed under the MIT license: https://github.com/oeasenet/goe/blob/main/LICENSE
         */
        :root {
            --bg: #ffffff;
            --fg: #171717;
            --muted: #6b6b6b;
            --faint: #9b9b9b;
            --accent: #7461F9;
            --wash: color-mix(in srgb, #7461F9 4%, #ffffff);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #0a0a0a;
                --fg: #ededed;
                --muted: #8f8f8f;
                --faint: #5c5c5c;
                --wash: color-mix(in srgb, #7461F9 6%, #0a0a0a);
            }
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            -webkit-font-smoothing: antialiased;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg);
            background-image: linear-gradient(180deg, var(--bg), var(--wash) 50%, var(--bg));
            color: var(--fg);
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 1.5rem;
        }

        main {
            text-align: center;
        }

        .code {
            color: var(--accent);
            font-size: 1.625rem;
            font-weight: 600;
            line-height: 1;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.01em;
        }

        h1 {
            font-size: 1.0625rem;
            font-weight: 500;
            margin: 0.75rem 0 0.5rem;
            letter-spacing: -0.01em;
        }

        p {
            font-size: 0.9375rem;
            line-height: 1.6;
            color: var(--muted);
            max-width: 26rem;
            margin: 0 auto;
            text-wrap: pretty;
        }

        footer {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 1.5rem;
            text-align: center;
            font-size: 0.8125rem;
            color: var(--faint);
        }

        footer a {
            color: var(--accent);
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

<main>
    <div class="code">{{ .Code }}</div>
    <h1>{{ .Title }}</h1>
    <p>{{ .Message }}</p>
</main>

<footer>
    Powered by <a href="https://github.com/oeasenet/goe" target="_blank" rel="noopener noreferrer">Goe Framework</a>
</footer>

</body>
</html>
