# GOE Custom Module Example Configuration

# Application
GOE_ENV=development
APP_NAME=goe-custom-module
APP_VERSION=1.0.0

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUT=console

# Custom Module Configuration
METRICS_COLLECT_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
