# GOE Event-Driven Example Configuration

# Application
GOE_ENV=development
APP_NAME=goe-event-driven
APP_VERSION=1.0.0

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUT=console

# Event System (Redis Streams)
EVENT_REDIS_ADDR=localhost:6379
EVENT_REDIS_PASSWORD=
EVENT_REDIS_DB=1
EVENT_MAX_RETRIES=3
EVENT_RETRY_DELAY=5s
EVENT_BATCH_SIZE=10
EVENT_BLOCK_TIMEOUT=5s
EVENT_ENABLE_DLQ=true
