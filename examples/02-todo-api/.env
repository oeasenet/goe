# GOE Todo API Example Configuration

# Application
GOE_ENV=development
APP_NAME=goe-todo-api
APP_VERSION=1.0.0

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUT=console

# MongoDB (using docker-compose credentials)
MONGO_URI=mongodb://goe:goepassword@localhost:27017
MONGO_DB_NAME=goe_examples

# Cache (Redis)
CACHE_STORE=redis
CACHE_PREFIX=todo_api:
CACHE_TTL=300
CACHE_REDIS_URL=redis://localhost:6379/0
