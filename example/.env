# Default environment configuration
APP_NAME=Goe Example Application
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUT=console
LOG_CALLER=true

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=goe_example
DB_USER=goe
DB_PASSWORD=secret

# HTTP Server configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=30s
HTTP_BODY_LIMIT=4194304
HTTP_STRICT_ROUTING=false
HTTP_CASE_SENSITIVE=false
HTTP_PREFORK=false
HTTP_SERVER_HEADER=Goe

# API Configuration
API_VERSION=v1

# Feature flags
FEATURE_CACHE_ENABLED=true
FEATURE_METRICS_ENABLED=true